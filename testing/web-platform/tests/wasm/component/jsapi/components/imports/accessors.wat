;; `[get]`/`[set]` imports: a top-level property, a method accessor pair on a
;; host resource, and a static accessor pair. Needs wasm-tools#2660.
(component
  (import "[get]x" (func $get-x (result u32)))
  (import "[set]x" (func $set-x (param "value" u32)))
  (import "r" (type $r (sub resource)))
  (import "[method][get]r.p" (func $get-p (param "self" (borrow $r)) (result u32)))
  (import "[method][set]r.p" (func $set-p (param "self" (borrow $r)) (param "value" u32)))
  (import "[static][get]r.q" (func $get-q (result u32)))
  (import "[static][set]r.q" (func $set-q (param "value" u32)))
  (core func $get-x' (canon lower (func $get-x)))
  (core func $set-x' (canon lower (func $set-x)))
  (core func $get-p' (canon lower (func $get-p)))
  (core func $set-p' (canon lower (func $set-p)))
  (core func $get-q' (canon lower (func $get-q)))
  (core func $set-q' (canon lower (func $set-q)))
  (core func $drop-r (canon resource.drop $r))
  (core module $M
    (import "" "get-x" (func $get-x (result i32)))
    (import "" "set-x" (func $set-x (param i32)))
    (import "" "get-p" (func $get-p (param i32) (result i32)))
    (import "" "set-p" (func $set-p (param i32 i32)))
    (import "" "get-q" (func $get-q (result i32)))
    (import "" "set-q" (func $set-q (param i32)))
    (import "" "drop-r" (func $drop-r (param i32)))
    (func (export "get-x") (result i32) (call $get-x))
    (func (export "set-x") (param i32) (call $set-x (local.get 0)))
    (func (export "get-p") (param i32) (result i32) (local $result i32)
      (local.set $result (call $get-p (local.get 0)))
      (call $drop-r (local.get 0))
      (local.get $result))
    (func (export "set-p") (param i32 i32)
      (call $set-p (local.get 0) (local.get 1))
      (call $drop-r (local.get 0)))
    (func (export "get-q") (result i32) (call $get-q))
    (func (export "set-q") (param i32) (call $set-q (local.get 0))))
  (core instance $m (instantiate $M (with "" (instance
    (export "get-x" (func $get-x'))
    (export "set-x" (func $set-x'))
    (export "get-p" (func $get-p'))
    (export "set-p" (func $set-p'))
    (export "get-q" (func $get-q'))
    (export "set-q" (func $set-q'))
    (export "drop-r" (func $drop-r))))))
  (func $get-x-export (result u32) (canon lift (core func $m "get-x")))
  (func $set-x-export (param "value" u32) (canon lift (core func $m "set-x")))
  (func $get-p-export (param "self" (borrow $r)) (result u32) (canon lift (core func $m "get-p")))
  (func $set-p-export (param "self" (borrow $r)) (param "value" u32) (canon lift (core func $m "set-p")))
  (func $get-q-export (result u32) (canon lift (core func $m "get-q")))
  (func $set-q-export (param "value" u32) (canon lift (core func $m "set-q")))
  (export "get-x" (func $get-x-export))
  (export "set-x" (func $set-x-export))
  (export "get-p" (func $get-p-export))
  (export "set-p" (func $set-p-export))
  (export "get-q" (func $get-q-export))
  (export "set-q" (func $set-q-export))
)
