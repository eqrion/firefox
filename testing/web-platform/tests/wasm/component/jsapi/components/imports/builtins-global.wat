;; Web APIs imported straight from `wasm:js/global`: plain functions, a WebIDL
;; interface (`URL`) as a resource, and a JS class (`Map`) as a resource.
(component
  (import "wasm:js/global" (instance $g
    (export "btoa" (func (param "data" string) (result string)))
    (export "atob" (func (param "data" string) (result string)))
    (export "URL" (type $url (sub resource)))
    (export "[constructor]URL" (func (param "url" string) (result (own $url))))
    (export "[method]URL.to-JSON" (func (param "self" (borrow $url)) (result string)))
    (export "[static]URL.can-parse" (func (param "url" string) (result bool)))
    (export "map" (type $map (sub resource)))
    (export "[constructor]map" (func (result (own $map))))
    (export "[method]map.set" (func (param "self" (borrow $map)) (param "key" string) (param "value" string)))
    (export "[method]map.get" (func (param "self" (borrow $map)) (param "key" string) (result (option string))))))
  (alias export $g "btoa" (func $btoa))
  (alias export $g "atob" (func $atob))
  (alias export $g "URL" (type $url))
  (alias export $g "[constructor]URL" (func $new-url))
  (alias export $g "[method]URL.to-JSON" (func $url-to-json))
  (alias export $g "[static]URL.can-parse" (func $url-can-parse))
  (alias export $g "map" (type $map))
  (alias export $g "[constructor]map" (func $new-map))
  (alias export $g "[method]map.set" (func $map-set))
  (alias export $g "[method]map.get" (func $map-get))
  (core module $Memory
    (memory (export "mem") 1)
    (global $next (mut i32) (i32.const 4096))
    (func (export "realloc") (param $old i32) (param $old-size i32) (param $align i32) (param $new-size i32) (result i32)
      (local $ptr i32) (local $pages i32)
      (local.set $ptr
        (i32.and
          (i32.add (global.get $next) (i32.sub (local.get $align) (i32.const 1)))
          (i32.sub (i32.const 0) (local.get $align))))
      (global.set $next (i32.add (local.get $ptr) (local.get $new-size)))
      (local.set $pages
        (i32.sub
          (i32.shr_u (i32.add (global.get $next) (i32.const 65535)) (i32.const 16))
          (memory.size)))
      (if (i32.gt_s (local.get $pages) (i32.const 0))
        (then (drop (memory.grow (local.get $pages)))))
      (if (local.get $old)
        (then (memory.copy (local.get $ptr) (local.get $old) (select (local.get $old-size) (local.get $new-size) (i32.lt_u (local.get $old-size) (local.get $new-size))))))
      (local.get $ptr)))
  (core instance $memory (instantiate $Memory))

  (core func $btoa' (canon lower (func $btoa) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $atob' (canon lower (func $atob) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $new-url' (canon lower (func $new-url) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $url-to-json' (canon lower (func $url-to-json) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $url-can-parse' (canon lower (func $url-can-parse) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $new-map' (canon lower (func $new-map)))
  (core func $map-set' (canon lower (func $map-set) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $map-get' (canon lower (func $map-get) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $drop-url (canon resource.drop $url))
  (core func $drop-map (canon resource.drop $map))
  (core module $M
    (import "" "mem" (memory 1))
    (import "" "realloc" (func $realloc (param i32 i32 i32 i32) (result i32)))
    (import "" "btoa" (func $btoa (param i32 i32 i32)))
    (import "" "atob" (func $atob (param i32 i32 i32)))
    (import "" "new-url" (func $new-url (param i32 i32) (result i32)))
    (import "" "url-to-json" (func $url-to-json (param i32 i32)))
    (import "" "url-can-parse" (func $url-can-parse (param i32 i32) (result i32)))
    (import "" "new-map" (func $new-map (result i32)))
    (import "" "map-set" (func $map-set (param i32 i32 i32 i32 i32)))
    (import "" "map-get" (func $map-get (param i32 i32 i32 i32)))
    (import "" "drop-url" (func $drop-url (param i32)))
    (import "" "drop-map" (func $drop-map (param i32)))
    (func $alloc (param $size i32) (result i32)
      (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (local.get $size)))
    (func (export "encode") (param $ptr i32) (param $len i32) (result i32)
      (local $ret i32)
      (local.set $ret (call $alloc (i32.const 8)))
      (call $btoa (local.get $ptr) (local.get $len) (local.get $ret))
      (local.get $ret))
    (func (export "decode") (param $ptr i32) (param $len i32) (result i32)
      (local $ret i32)
      (local.set $ret (call $alloc (i32.const 8)))
      (call $atob (local.get $ptr) (local.get $len) (local.get $ret))
      (local.get $ret))
    (func (export "url-json") (param $ptr i32) (param $len i32) (result i32)
      (local $ret i32) (local $h i32)
      (local.set $ret (call $alloc (i32.const 8)))
      (local.set $h (call $new-url (local.get $ptr) (local.get $len)))
      (call $url-to-json (local.get $h) (local.get $ret))
      (call $drop-url (local.get $h))
      (local.get $ret))
    (func (export "can-parse") (param $ptr i32) (param $len i32) (result i32)
      (call $url-can-parse (local.get $ptr) (local.get $len)))
    (func (export "map-roundtrip") (param $kptr i32) (param $klen i32) (param $vptr i32) (param $vlen i32) (result i32)
      (local $ret i32) (local $h i32)
      (local.set $ret (call $alloc (i32.const 12)))
      (local.set $h (call $new-map))
      (call $map-set (local.get $h) (local.get $kptr) (local.get $klen) (local.get $vptr) (local.get $vlen))
      (call $map-get (local.get $h) (local.get $kptr) (local.get $klen) (local.get $ret))
      (call $drop-map (local.get $h))
      (local.get $ret)))
  (core instance $m (instantiate $M (with "" (instance
    (export "mem" (memory $memory "mem"))
    (export "realloc" (func $memory "realloc"))
    (export "btoa" (func $btoa'))
    (export "atob" (func $atob'))
    (export "new-url" (func $new-url'))
    (export "url-to-json" (func $url-to-json'))
    (export "url-can-parse" (func $url-can-parse'))
    (export "new-map" (func $new-map'))
    (export "map-set" (func $map-set'))
    (export "map-get" (func $map-get'))
    (export "drop-url" (func $drop-url))
    (export "drop-map" (func $drop-map))))))
  (func $encode (param "data" string) (result string) (canon lift (core func $m "encode") (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (func $decode (param "data" string) (result string) (canon lift (core func $m "decode") (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (func $url-json (param "url" string) (result string) (canon lift (core func $m "url-json") (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (func $can-parse (param "url" string) (result bool) (canon lift (core func $m "can-parse") (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (func $map-roundtrip (param "key" string) (param "value" string) (result (option string))
    (canon lift (core func $m "map-roundtrip") (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (export "encode" (func $encode))
  (export "decode" (func $decode))
  (export "url-json" (func $url-json))
  (export "can-parse" (func $can-parse))
  (export "map-roundtrip" (func $map-roundtrip))
)
