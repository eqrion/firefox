;; Instance imports: nested lookups, a resource inside an instance, an
;; interface-named instance, and an instance export named like a builtin.
(component
  (import "iface" (instance $iface
    (export "f" (func (param "x" u32) (result u32)))
    (export "r" (type $r (sub resource)))
    (export "[constructor]r" (func (result (own $r))))
    (export "[method]r.m" (func (param "self" (borrow $r)) (result u32)))
    (export "nested" (instance (export "g" (func (result u32)))))))
  (import "wasi:clocks/wall-clock@0.2.0" (instance $clock (export "now" (func (result u64)))))
  (import "outer" (instance $outer
    (export "wasm:js/global" (instance (export "h" (func (result u32)))))))
  (alias export $iface "f" (func $f))
  (alias export $iface "r" (type $r))
  (alias export $iface "[constructor]r" (func $make))
  (alias export $iface "[method]r.m" (func $m))
  (alias export $iface "nested" (instance $nested))
  (alias export $nested "g" (func $g))
  (alias export $clock "now" (func $now))
  (alias export $outer "wasm:js/global" (instance $fake-global))
  (alias export $fake-global "h" (func $h))
  (core func $f' (canon lower (func $f)))
  (core func $make' (canon lower (func $make)))
  (core func $m' (canon lower (func $m)))
  (core func $g' (canon lower (func $g)))
  (core func $now' (canon lower (func $now)))
  (core func $h' (canon lower (func $h)))
  (core func $drop (canon resource.drop $r))
  (core module $M
    (import "" "f" (func $f (param i32) (result i32)))
    (import "" "make" (func $make (result i32)))
    (import "" "m" (func $m (param i32) (result i32)))
    (import "" "g" (func $g (result i32)))
    (import "" "now" (func $now (result i64)))
    (import "" "h" (func $h (result i32)))
    (import "" "drop" (func $drop (param i32)))
    (func (export "call-f") (param i32) (result i32) (call $f (local.get 0)))
    (func (export "make-m") (result i32)
      (local $h i32) (local $r i32)
      (local.set $h (call $make))
      (local.set $r (call $m (local.get $h)))
      (call $drop (local.get $h))
      (local.get $r))
    (func (export "call-g") (result i32) (call $g))
    (func (export "now") (result i64) (call $now))
    (func (export "call-h") (result i32) (call $h)))
  (core instance $m (instantiate $M (with "" (instance
    (export "f" (func $f'))
    (export "make" (func $make'))
    (export "m" (func $m'))
    (export "g" (func $g'))
    (export "now" (func $now'))
    (export "h" (func $h'))
    (export "drop" (func $drop))))))
  (func $call-f (param "x" u32) (result u32) (canon lift (core func $m "call-f")))
  (func $make-m (result u32) (canon lift (core func $m "make-m")))
  (func $call-g (result u32) (canon lift (core func $m "call-g")))
  (func $now-export (result u64) (canon lift (core func $m "now")))
  (func $call-h (result u32) (canon lift (core func $m "call-h")))
  (export "call-f" (func $call-f))
  (export "make-m" (func $make-m))
  (export "call-g" (func $call-g))
  (export "now" (func $now-export))
  (export "call-h" (func $call-h))
)
