;; Plain function imports and exports named with every row of the casing
;; table. Each export calls the import of the same name.
(component
  (import "element" (func $element (result u32)))
  (import "query-selector" (func $query-selector (result u32)))
  (import "inner-HTML" (func $inner-HTML (result u32)))
  (import "XML-http-request" (func $XML-http-request (result u32)))
  (import "URL" (func $URL (result u32)))
  (import "a1-2-3" (func $a1-2-3 (result u32)))
  (import "HTTP-request" (func $HTTP-request (result u32)))
  (core func $element' (canon lower (func $element)))
  (core func $query-selector' (canon lower (func $query-selector)))
  (core func $inner-HTML' (canon lower (func $inner-HTML)))
  (core func $XML-http-request' (canon lower (func $XML-http-request)))
  (core func $URL' (canon lower (func $URL)))
  (core func $a1-2-3' (canon lower (func $a1-2-3)))
  (core func $HTTP-request' (canon lower (func $HTTP-request)))
  (core module $M
    (import "" "element" (func $element (result i32)))
    (import "" "query-selector" (func $query-selector (result i32)))
    (import "" "inner-HTML" (func $inner-HTML (result i32)))
    (import "" "XML-http-request" (func $XML-http-request (result i32)))
    (import "" "URL" (func $URL (result i32)))
    (import "" "a1-2-3" (func $a1-2-3 (result i32)))
    (import "" "HTTP-request" (func $HTTP-request (result i32)))
    (func (export "element") (result i32) (call $element))
    (func (export "query-selector") (result i32) (call $query-selector))
    (func (export "inner-HTML") (result i32) (call $inner-HTML))
    (func (export "XML-http-request") (result i32) (call $XML-http-request))
    (func (export "URL") (result i32) (call $URL))
    (func (export "a1-2-3") (result i32) (call $a1-2-3))
    (func (export "HTTP-request") (result i32) (call $HTTP-request)))
  (core instance $m (instantiate $M (with "" (instance
    (export "element" (func $element'))
    (export "query-selector" (func $query-selector'))
    (export "inner-HTML" (func $inner-HTML'))
    (export "XML-http-request" (func $XML-http-request'))
    (export "URL" (func $URL'))
    (export "a1-2-3" (func $a1-2-3'))
    (export "HTTP-request" (func $HTTP-request'))))))
  (func $e (result u32) (canon lift (core func $m "element")))
  (func $q (result u32) (canon lift (core func $m "query-selector")))
  (func $i (result u32) (canon lift (core func $m "inner-HTML")))
  (func $x (result u32) (canon lift (core func $m "XML-http-request")))
  (func $u (result u32) (canon lift (core func $m "URL")))
  (func $a (result u32) (canon lift (core func $m "a1-2-3")))
  (func $h (result u32) (canon lift (core func $m "HTTP-request")))
  (export "element" (func $e))
  (export "query-selector" (func $q))
  (export "inner-HTML" (func $i))
  (export "XML-http-request" (func $x))
  (export "URL" (func $u))
  (export "a1-2-3" (func $a))
  (export "HTTP-request" (func $h))
)
