;; Resource type exports named with every row of the casing table, plus
;; methods and statics on `element` named the same way.
(component
  (type $element (resource (rep i32)))
  (type $query-selector (resource (rep i32)))
  (type $inner-HTML (resource (rep i32)))
  (type $XML-http-request (resource (rep i32)))
  (type $URL (resource (rep i32)))
  (type $a1-2-3 (resource (rep i32)))
  (type $HTTP-request (resource (rep i32)))
  (canon resource.new $element (core func $new))
  (core module $M
    (import "" "new" (func $new (param i32) (result i32)))
    (func (export "ctor") (result i32) (call $new (i32.const 7)))
    (func (export "method") (param i32) (result i32) (local.get 0))
    (func (export "static") (result i32) (i32.const 1)))
  (core instance $m (instantiate $M (with "" (instance (export "new" (func $new))))))
  (export $e "element" (type $element))
  (export "query-selector" (type $query-selector))
  (export "inner-HTML" (type $inner-HTML))
  (export "XML-http-request" (type $XML-http-request))
  (export "URL" (type $URL))
  (export "a1-2-3" (type $a1-2-3))
  (export "HTTP-request" (type $HTTP-request))
  (func $ctor (result (own $e)) (canon lift (core func $m "ctor")))
  (func $method (param "self" (borrow $e)) (result u32) (canon lift (core func $m "method")))
  (func $static (result u32) (canon lift (core func $m "static")))
  (export "[constructor]element" (func $ctor))
  (export "[method]element.query-selector" (func $method))
  (export "[method]element.inner-HTML" (func $method))
  (export "[method]element.a1-2-3" (func $method))
  (export "[method]element.HTTP-request" (func $method))
  (export "[static]element.XML-http-request" (func $static))
  (export "[static]element.URL" (func $static))
)
