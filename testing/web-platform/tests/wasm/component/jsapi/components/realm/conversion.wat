;; Produces one value of each JS object kind the JS-API creates, so tests can
;; check which realm those objects belong to. Also imports `marker` from
;; `wasm:js/global` to observe which global the builtin resolves to.
(component
  (import "wasm:js/global" (instance $g
    (export "marker" (func (result u32)))))
  (alias export $g "marker" (func $marker))
  (core func $marker' (canon lower (func $marker)))

  (type $counter (resource (rep i32)))
  (core func $new (canon resource.new $counter))

  (core module $M
    (import "" "marker" (func $marker (result i32)))
    (import "" "new" (func $new (param i32) (result i32)))
    (memory (export "mem") 1)
    (data (i32.const 8) "\01\00\00\00\02\00\00\00\03\00\00\00")
    (data (i32.const 40) "\0a\0b")
    (data (i32.const 84) "a")
    (data (i32.const 108) "err")
    (func (export "make-list") (result i32)
      (i32.store (i32.const 0) (i32.const 8))
      (i32.store (i32.const 4) (i32.const 3))
      (i32.const 0))
    (func (export "make-bytes") (result i32)
      (i32.store (i32.const 32) (i32.const 40))
      (i32.store (i32.const 36) (i32.const 2))
      (i32.const 32))
    (func (export "make-map") (result i32)
      (i32.store (i32.const 64) (i32.const 72))
      (i32.store (i32.const 68) (i32.const 1))
      (i32.store (i32.const 72) (i32.const 84))
      (i32.store (i32.const 76) (i32.const 1))
      (i32.store (i32.const 80) (i32.const 5))
      (i32.const 64))
    (func (export "fail") (result i32)
      (i32.store (i32.const 96) (i32.const 1))
      (i32.store (i32.const 100) (i32.const 108))
      (i32.store (i32.const 104) (i32.const 3))
      (i32.const 96))
    (func (export "call-marker") (result i32) (call $marker))
    (func (export "ctor") (result i32) (call $new (i32.const 1))))
  (core instance $m (instantiate $M (with "" (instance
    (export "marker" (func $marker'))
    (export "new" (func $new))))))

  (func $make-list (result (list u32))
    (canon lift (core func $m "make-list") (memory (core memory $m "mem"))))
  (func $make-bytes (result (list u8))
    (canon lift (core func $m "make-bytes") (memory (core memory $m "mem"))))
  (func $make-map (result (map string u32))
    (canon lift (core func $m "make-map") (memory (core memory $m "mem"))))
  (func $fail (result (result (error string)))
    (canon lift (core func $m "fail") (memory (core memory $m "mem"))))
  (func $call-marker (result u32) (canon lift (core func $m "call-marker")))
  (func $ctor (result (own $counter)) (canon lift (core func $m "ctor")))

  (export "make-list" (func $make-list))
  (export "make-bytes" (func $make-bytes))
  (export "make-map" (func $make-map))
  (export "fail" (func $fail))
  (export "call-marker" (func $call-marker))
  (export $counter' "counter" (type $counter))
  (export "[constructor]counter" (func $ctor) (func (result (own $counter'))))
)
