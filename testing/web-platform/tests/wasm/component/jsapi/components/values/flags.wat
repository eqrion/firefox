;; Passthrough for flags of 1, 8, 16 and 32 labels. Every flags type is a
;; single i32 in the canonical ABI, so no memory is involved.
(component
  (type $one-def (flags "a"))
  (type $eight-def (flags "read" "write" "exec" "is-dir" "is-file" "hidden" "read-only" "HTML"))
  (type $sixteen-def (flags "b0" "b1" "b2" "b3" "b4" "b5" "b6" "b7" "b8" "b9" "b10" "b11" "b12" "b13" "b14" "b15"))
  (type $thirty-two-def (flags "b0" "b1" "b2" "b3" "b4" "b5" "b6" "b7" "b8" "b9" "b10" "b11" "b12" "b13" "b14" "b15" "b16" "b17" "b18" "b19" "b20" "b21" "b22" "b23" "b24" "b25" "b26" "b27" "b28" "b29" "b30" "b31"))
  (import "one" (type $one (eq $one-def)))
  (import "eight" (type $eight (eq $eight-def)))
  (import "sixteen" (type $sixteen (eq $sixteen-def)))
  (import "thirty-two" (type $thirty-two (eq $thirty-two-def)))
  (import "echo-one" (func $echo-one (param "x" $one) (result $one)))
  (import "echo-eight" (func $echo-eight (param "x" $eight) (result $eight)))
  (import "echo-sixteen" (func $echo-sixteen (param "x" $sixteen) (result $sixteen)))
  (import "echo-thirty-two" (func $echo-thirty-two (param "x" $thirty-two) (result $thirty-two)))

  (core func $echo-one' (canon lower (func $echo-one)))
  (core func $echo-eight' (canon lower (func $echo-eight)))
  (core func $echo-sixteen' (canon lower (func $echo-sixteen)))
  (core func $echo-thirty-two' (canon lower (func $echo-thirty-two)))

  (core module $M
    (import "" "echo-one" (func $echo-one (param i32) (result i32)))
    (import "" "echo-eight" (func $echo-eight (param i32) (result i32)))
    (import "" "echo-sixteen" (func $echo-sixteen (param i32) (result i32)))
    (import "" "echo-thirty-two" (func $echo-thirty-two (param i32) (result i32)))
    (func (export "roundtrip-one") (param i32) (result i32)
      (call $echo-one (local.get 0)))
    (func (export "roundtrip-eight") (param i32) (result i32)
      (call $echo-eight (local.get 0)))
    (func (export "roundtrip-sixteen") (param i32) (result i32)
      (call $echo-sixteen (local.get 0)))
    (func (export "roundtrip-thirty-two") (param i32) (result i32)
      (call $echo-thirty-two (local.get 0)))
  )
  (core instance $m (instantiate $M (with "" (instance
    (export "echo-one" (func $echo-one'))
    (export "echo-eight" (func $echo-eight'))
    (export "echo-sixteen" (func $echo-sixteen'))
    (export "echo-thirty-two" (func $echo-thirty-two'))
  ))))

  (func $roundtrip-one (param "x" $one) (result $one)
    (canon lift (core func $m "roundtrip-one")))
  (export "roundtrip-one" (func $roundtrip-one))
  (func $roundtrip-eight (param "x" $eight) (result $eight)
    (canon lift (core func $m "roundtrip-eight")))
  (export "roundtrip-eight" (func $roundtrip-eight))
  (func $roundtrip-sixteen (param "x" $sixteen) (result $sixteen)
    (canon lift (core func $m "roundtrip-sixteen")))
  (export "roundtrip-sixteen" (func $roundtrip-sixteen))
  (func $roundtrip-thirty-two (param "x" $thirty-two) (result $thirty-two)
    (canon lift (core func $m "roundtrip-thirty-two")))
  (export "roundtrip-thirty-two" (func $roundtrip-thirty-two))
)
