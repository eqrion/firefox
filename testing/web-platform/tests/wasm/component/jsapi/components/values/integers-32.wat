;; Passthroughs for the integer types that flatten to i32 (u32 has its own fixture).
(component
  (import "echo-s8" (func $echo-s8 (param "x" s8) (result s8)))
  (import "echo-s16" (func $echo-s16 (param "x" s16) (result s16)))
  (import "echo-s32" (func $echo-s32 (param "x" s32) (result s32)))
  (import "echo-u8" (func $echo-u8 (param "x" u8) (result u8)))
  (import "echo-u16" (func $echo-u16 (param "x" u16) (result u16)))
  (core func $echo-s8' (canon lower (func $echo-s8)))
  (core func $echo-s16' (canon lower (func $echo-s16)))
  (core func $echo-s32' (canon lower (func $echo-s32)))
  (core func $echo-u8' (canon lower (func $echo-u8)))
  (core func $echo-u16' (canon lower (func $echo-u16)))
  (core module $M
    (import "" "echo-s8" (func $echo-s8 (param i32) (result i32)))
    (import "" "echo-s16" (func $echo-s16 (param i32) (result i32)))
    (import "" "echo-s32" (func $echo-s32 (param i32) (result i32)))
    (import "" "echo-u8" (func $echo-u8 (param i32) (result i32)))
    (import "" "echo-u16" (func $echo-u16 (param i32) (result i32)))
    (func (export "roundtrip-s8") (param i32) (result i32)
      (call $echo-s8 (local.get 0)))
    (func (export "roundtrip-s16") (param i32) (result i32)
      (call $echo-s16 (local.get 0)))
    (func (export "roundtrip-s32") (param i32) (result i32)
      (call $echo-s32 (local.get 0)))
    (func (export "roundtrip-u8") (param i32) (result i32)
      (call $echo-u8 (local.get 0)))
    (func (export "roundtrip-u16") (param i32) (result i32)
      (call $echo-u16 (local.get 0)))
  )
  (core instance $m (instantiate $M (with "" (instance
    (export "echo-s8" (func $echo-s8'))
    (export "echo-s16" (func $echo-s16'))
    (export "echo-s32" (func $echo-s32'))
    (export "echo-u8" (func $echo-u8'))
    (export "echo-u16" (func $echo-u16'))
  ))))
  (func $roundtrip-s8 (param "x" s8) (result s8) (canon lift (core func $m "roundtrip-s8")))
  (export "roundtrip-s8" (func $roundtrip-s8))
  (func $roundtrip-s16 (param "x" s16) (result s16) (canon lift (core func $m "roundtrip-s16")))
  (export "roundtrip-s16" (func $roundtrip-s16))
  (func $roundtrip-s32 (param "x" s32) (result s32) (canon lift (core func $m "roundtrip-s32")))
  (export "roundtrip-s32" (func $roundtrip-s32))
  (func $roundtrip-u8 (param "x" u8) (result u8) (canon lift (core func $m "roundtrip-u8")))
  (export "roundtrip-u8" (func $roundtrip-u8))
  (func $roundtrip-u16 (param "x" u16) (result u16) (canon lift (core func $m "roundtrip-u16")))
  (export "roundtrip-u16" (func $roundtrip-u16))
)
