(component
  (import "echo-f32" (func $echo-f32 (param "x" f32) (result f32)))
  (import "echo-f64" (func $echo-f64 (param "x" f64) (result f64)))
  (import "recv-f32" (func $recv-f32 (param "x" f32)))
  (import "recv-f64" (func $recv-f64 (param "x" f64)))
  (core func $echo-f32' (canon lower (func $echo-f32)))
  (core func $echo-f64' (canon lower (func $echo-f64)))
  (core func $recv-f32' (canon lower (func $recv-f32)))
  (core func $recv-f64' (canon lower (func $recv-f64)))
  (core module $M
    (import "" "echo-f32" (func $echo-f32 (param f32) (result f32)))
    (import "" "echo-f64" (func $echo-f64 (param f64) (result f64)))
    (import "" "recv-f32" (func $recv-f32 (param f32)))
    (import "" "recv-f64" (func $recv-f64 (param f64)))
    (func (export "roundtrip-f32") (param f32) (result f32) (call $echo-f32 (local.get 0)))
    (func (export "roundtrip-f64") (param f64) (result f64) (call $echo-f64 (local.get 0)))
    ;; Guest-produced specials: NaNs with payload bits, infinities, signed zero,
    ;; a denormal and the largest finite value of each width.
    (func (export "send")
      (call $recv-f32 (f32.reinterpret_i32 (i32.const 0x7fc00001)))
      (call $recv-f32 (f32.reinterpret_i32 (i32.const 0xffa00000)))
      (call $recv-f32 (f32.const inf))
      (call $recv-f32 (f32.const -inf))
      (call $recv-f32 (f32.const -0))
      (call $recv-f32 (f32.reinterpret_i32 (i32.const 1)))
      (call $recv-f32 (f32.reinterpret_i32 (i32.const 0x7f7fffff)))
      (call $recv-f64 (f64.reinterpret_i64 (i64.const 0x7ff8000000000001)))
      (call $recv-f64 (f64.reinterpret_i64 (i64.const 0xfff4000000000000)))
      (call $recv-f64 (f64.const inf))
      (call $recv-f64 (f64.const -inf))
      (call $recv-f64 (f64.const -0))
      (call $recv-f64 (f64.reinterpret_i64 (i64.const 1)))
      (call $recv-f64 (f64.reinterpret_i64 (i64.const 0x7fefffffffffffff)))))
  (core instance $m (instantiate $M (with "" (instance
    (export "echo-f32" (func $echo-f32'))
    (export "echo-f64" (func $echo-f64'))
    (export "recv-f32" (func $recv-f32'))
    (export "recv-f64" (func $recv-f64'))))))
  (func $roundtrip-f32 (param "x" f32) (result f32) (canon lift (core func $m "roundtrip-f32")))
  (func $roundtrip-f64 (param "x" f64) (result f64) (canon lift (core func $m "roundtrip-f64")))
  (func $send (canon lift (core func $m "send")))
  (export "roundtrip-f32" (func $roundtrip-f32))
  (export "roundtrip-f64" (func $roundtrip-f64))
  (export "send" (func $send))
)
