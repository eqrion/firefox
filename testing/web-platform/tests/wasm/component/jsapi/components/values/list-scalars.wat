;; Passthroughs for lists of each scalar type, which are typed arrays in JS,
;; a list<f64, 2> passthrough, and a spy that is sent NaNs that are not
;; canonical.
(component
  (import "echo-s8" (func $echo-s8 (param "x" (list s8)) (result (list s8))))
  (import "echo-u8" (func $echo-u8 (param "x" (list u8)) (result (list u8))))
  (import "echo-s16" (func $echo-s16 (param "x" (list s16)) (result (list s16))))
  (import "echo-u16" (func $echo-u16 (param "x" (list u16)) (result (list u16))))
  (import "echo-s32" (func $echo-s32 (param "x" (list s32)) (result (list s32))))
  (import "echo-u32" (func $echo-u32 (param "x" (list u32)) (result (list u32))))
  (import "echo-s64" (func $echo-s64 (param "x" (list s64)) (result (list s64))))
  (import "echo-u64" (func $echo-u64 (param "x" (list u64)) (result (list u64))))
  (import "echo-f32" (func $echo-f32 (param "x" (list f32)) (result (list f32))))
  (import "echo-f64" (func $echo-f64 (param "x" (list f64)) (result (list f64))))
  (import "echo-f64x2" (func $echo-f64x2 (param "x" (list f64 2)) (result (list f64 2))))
  (import "recv-f32" (func $recv-f32 (param "x" (list f32))))
  (import "recv-f64" (func $recv-f64 (param "x" (list f64))))
  (core module $Memory
    (memory (export "mem") 1)
    (global $next (mut i32) (i32.const 16))
    (func (export "realloc") (param $old i32) (param $old-size i32) (param $align i32) (param $new-size i32) (result i32)
      (local $ptr i32) (local $pages i32)
      (local.set $ptr
        (i32.and
          (i32.add (global.get $next) (i32.sub (local.get $align) (i32.const 1)))
          (i32.sub (i32.const 0) (local.get $align))))
      (global.set $next (i32.add (local.get $ptr) (local.get $new-size)))
      (local.set $pages
        (i32.sub
          (i32.shr_u (i32.add (global.get $next) (i32.const 65535)) (i32.const 16))
          (memory.size)))
      (if (i32.gt_s (local.get $pages) (i32.const 0))
        (then (drop (memory.grow (local.get $pages)))))
      (if (local.get $old)
        (then (memory.copy (local.get $ptr) (local.get $old) (select (local.get $old-size) (local.get $new-size) (i32.lt_u (local.get $old-size) (local.get $new-size))))))
      (local.get $ptr)))
  (core instance $memory (instantiate $Memory))
  (core func $echo-s8' (canon lower (func $echo-s8) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $echo-u8' (canon lower (func $echo-u8) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $echo-s16' (canon lower (func $echo-s16) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $echo-u16' (canon lower (func $echo-u16) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $echo-s32' (canon lower (func $echo-s32) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $echo-u32' (canon lower (func $echo-u32) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $echo-s64' (canon lower (func $echo-s64) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $echo-u64' (canon lower (func $echo-u64) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $echo-f32' (canon lower (func $echo-f32) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $echo-f64' (canon lower (func $echo-f64) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $echo-f64x2' (canon lower (func $echo-f64x2) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $recv-f32' (canon lower (func $recv-f32) (memory (core memory $memory "mem"))))
  (core func $recv-f64' (canon lower (func $recv-f64) (memory (core memory $memory "mem"))))
  (core module $M
    (import "" "mem" (memory 1))
    (import "" "realloc" (func $realloc (param i32 i32 i32 i32) (result i32)))
    (import "" "echo-s8" (func $echo-s8 (param i32 i32 i32)))
    (import "" "echo-u8" (func $echo-u8 (param i32 i32 i32)))
    (import "" "echo-s16" (func $echo-s16 (param i32 i32 i32)))
    (import "" "echo-u16" (func $echo-u16 (param i32 i32 i32)))
    (import "" "echo-s32" (func $echo-s32 (param i32 i32 i32)))
    (import "" "echo-u32" (func $echo-u32 (param i32 i32 i32)))
    (import "" "echo-s64" (func $echo-s64 (param i32 i32 i32)))
    (import "" "echo-u64" (func $echo-u64 (param i32 i32 i32)))
    (import "" "echo-f32" (func $echo-f32 (param i32 i32 i32)))
    (import "" "echo-f64" (func $echo-f64 (param i32 i32 i32)))
    (import "" "echo-f64x2" (func $echo-f64x2 (param f64 f64 i32)))
    (import "" "recv-f32" (func $recv-f32 (param i32 i32)))
    (import "" "recv-f64" (func $recv-f64 (param i32 i32)))
    ;; f32 NaNs 0x7fc00001 and 0xffc00000, then f64 NaNs 0x7ff0000000000001 and
    ;; 0xfff8000000000000.
    (data (i32.const 8) "\01\00\c0\7f\00\00\c0\ff")
    (data (i32.const 16) "\01\00\00\00\00\00\f0\7f\00\00\00\00\00\00\f8\ff")
    (func (export "send-nans")
      (call $recv-f32 (i32.const 8) (i32.const 2))
      (call $recv-f64 (i32.const 16) (i32.const 2)))
    (func (export "roundtrip-s8") (param i32 i32) (result i32)
      (local $ret i32)
      (local.set $ret (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (i32.const 8)))
      (call $echo-s8 (local.get 0) (local.get 1) (local.get $ret))
      (local.get $ret))
    (func (export "roundtrip-u8") (param i32 i32) (result i32)
      (local $ret i32)
      (local.set $ret (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (i32.const 8)))
      (call $echo-u8 (local.get 0) (local.get 1) (local.get $ret))
      (local.get $ret))
    (func (export "roundtrip-s16") (param i32 i32) (result i32)
      (local $ret i32)
      (local.set $ret (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (i32.const 8)))
      (call $echo-s16 (local.get 0) (local.get 1) (local.get $ret))
      (local.get $ret))
    (func (export "roundtrip-u16") (param i32 i32) (result i32)
      (local $ret i32)
      (local.set $ret (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (i32.const 8)))
      (call $echo-u16 (local.get 0) (local.get 1) (local.get $ret))
      (local.get $ret))
    (func (export "roundtrip-s32") (param i32 i32) (result i32)
      (local $ret i32)
      (local.set $ret (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (i32.const 8)))
      (call $echo-s32 (local.get 0) (local.get 1) (local.get $ret))
      (local.get $ret))
    (func (export "roundtrip-u32") (param i32 i32) (result i32)
      (local $ret i32)
      (local.set $ret (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (i32.const 8)))
      (call $echo-u32 (local.get 0) (local.get 1) (local.get $ret))
      (local.get $ret))
    (func (export "roundtrip-s64") (param i32 i32) (result i32)
      (local $ret i32)
      (local.set $ret (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (i32.const 8)))
      (call $echo-s64 (local.get 0) (local.get 1) (local.get $ret))
      (local.get $ret))
    (func (export "roundtrip-u64") (param i32 i32) (result i32)
      (local $ret i32)
      (local.set $ret (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (i32.const 8)))
      (call $echo-u64 (local.get 0) (local.get 1) (local.get $ret))
      (local.get $ret))
    (func (export "roundtrip-f32") (param i32 i32) (result i32)
      (local $ret i32)
      (local.set $ret (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (i32.const 8)))
      (call $echo-f32 (local.get 0) (local.get 1) (local.get $ret))
      (local.get $ret))
    (func (export "roundtrip-f64") (param i32 i32) (result i32)
      (local $ret i32)
      (local.set $ret (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (i32.const 8)))
      (call $echo-f64 (local.get 0) (local.get 1) (local.get $ret))
      (local.get $ret))
    (func (export "roundtrip-f64x2") (param f64 f64) (result i32)
      (local $ret i32)
      (local.set $ret (call $realloc (i32.const 0) (i32.const 0) (i32.const 8) (i32.const 16)))
      (call $echo-f64x2 (local.get 0) (local.get 1) (local.get $ret))
      (local.get $ret))
  )
  (core instance $m (instantiate $M (with "" (instance
    (export "mem" (memory $memory "mem"))
    (export "realloc" (func $memory "realloc"))
    (export "echo-s8" (func $echo-s8'))
    (export "echo-u8" (func $echo-u8'))
    (export "echo-s16" (func $echo-s16'))
    (export "echo-u16" (func $echo-u16'))
    (export "echo-s32" (func $echo-s32'))
    (export "echo-u32" (func $echo-u32'))
    (export "echo-s64" (func $echo-s64'))
    (export "echo-u64" (func $echo-u64'))
    (export "echo-f32" (func $echo-f32'))
    (export "echo-f64" (func $echo-f64'))
    (export "echo-f64x2" (func $echo-f64x2'))
    (export "recv-f32" (func $recv-f32'))
    (export "recv-f64" (func $recv-f64'))
  ))))
  (func $roundtrip-s8 (param "x" (list s8)) (result (list s8)) (canon lift (core func $m "roundtrip-s8") (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (export "roundtrip-s8" (func $roundtrip-s8))
  (func $roundtrip-u8 (param "x" (list u8)) (result (list u8)) (canon lift (core func $m "roundtrip-u8") (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (export "roundtrip-u8" (func $roundtrip-u8))
  (func $roundtrip-s16 (param "x" (list s16)) (result (list s16)) (canon lift (core func $m "roundtrip-s16") (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (export "roundtrip-s16" (func $roundtrip-s16))
  (func $roundtrip-u16 (param "x" (list u16)) (result (list u16)) (canon lift (core func $m "roundtrip-u16") (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (export "roundtrip-u16" (func $roundtrip-u16))
  (func $roundtrip-s32 (param "x" (list s32)) (result (list s32)) (canon lift (core func $m "roundtrip-s32") (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (export "roundtrip-s32" (func $roundtrip-s32))
  (func $roundtrip-u32 (param "x" (list u32)) (result (list u32)) (canon lift (core func $m "roundtrip-u32") (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (export "roundtrip-u32" (func $roundtrip-u32))
  (func $roundtrip-s64 (param "x" (list s64)) (result (list s64)) (canon lift (core func $m "roundtrip-s64") (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (export "roundtrip-s64" (func $roundtrip-s64))
  (func $roundtrip-u64 (param "x" (list u64)) (result (list u64)) (canon lift (core func $m "roundtrip-u64") (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (export "roundtrip-u64" (func $roundtrip-u64))
  (func $roundtrip-f32 (param "x" (list f32)) (result (list f32)) (canon lift (core func $m "roundtrip-f32") (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (export "roundtrip-f32" (func $roundtrip-f32))
  (func $roundtrip-f64 (param "x" (list f64)) (result (list f64)) (canon lift (core func $m "roundtrip-f64") (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (export "roundtrip-f64" (func $roundtrip-f64))
  (func $roundtrip-f64x2 (param "x" (list f64 2)) (result (list f64 2)) (canon lift (core func $m "roundtrip-f64x2") (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (export "roundtrip-f64x2" (func $roundtrip-f64x2))
  (func $send-nans (canon lift (core func $m "send-nans")))
  (export "send-nans" (func $send-nans))
)
