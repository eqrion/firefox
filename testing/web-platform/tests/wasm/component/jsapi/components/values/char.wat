(component
  (import "echo" (func $echo (param "x" char) (result char)))
  (import "recv" (func $recv (param "x" char)))
  (core func $echo' (canon lower (func $echo)))
  (core func $recv' (canon lower (func $recv)))
  (core module $M
    (import "" "echo" (func $echo (param i32) (result i32)))
    (import "" "recv" (func $recv (param i32)))
    (func (export "roundtrip") (param i32) (result i32)
      (call $echo (local.get 0)))
    ;; Scalar value boundaries.
    (func (export "send")
      (call $recv (i32.const 0))
      (call $recv (i32.const 0x61))
      (call $recv (i32.const 0xd7ff))
      (call $recv (i32.const 0xe000))
      (call $recv (i32.const 0xffff))
      (call $recv (i32.const 0x10000))
      (call $recv (i32.const 0x1f600))
      (call $recv (i32.const 0x10ffff)))
    ;; Lifting a surrogate code point or an out-of-range value traps.
    (func (export "send-surrogate") (call $recv (i32.const 0xd800)))
    (func (export "send-out-of-range") (call $recv (i32.const 0x110000))))
  (core instance $m (instantiate $M (with "" (instance
    (export "echo" (func $echo'))
    (export "recv" (func $recv'))))))
  (func $roundtrip (param "x" char) (result char) (canon lift (core func $m "roundtrip")))
  (func $send (canon lift (core func $m "send")))
  (func $send-surrogate (canon lift (core func $m "send-surrogate")))
  (func $send-out-of-range (canon lift (core func $m "send-out-of-range")))
  (export "roundtrip" (func $roundtrip))
  (export "send" (func $send))
  (export "send-surrogate" (func $send-surrogate))
  (export "send-out-of-range" (func $send-out-of-range))
)
