;; Nested compound types: lists of records, options of lists, variants with
;; record payloads, tuples, results in lists, a 50-deep list, and acronym
;; labels.
(component
  (type $tagged-def (record (field "name" string) (field "tags" (list string))))
  (import "tagged" (type $tagged (eq $tagged-def)))
  (type $point-def (record (field "x" u32) (field "y" u32)))
  (import "point" (type $point (eq $point-def)))
  (type $shape-def (variant (case "point" $point) (case "name" string)))
  (import "shape" (type $shape (eq $shape-def)))
  (type $web-page-def (record (field "URL" string) (field "HTTP-status" u32) (field "XML-body" (option string))))
  (import "web-page" (type $web-page (eq $web-page-def)))
  (type $l1 (list u32))
  (type $l2 (list $l1))
  (type $l3 (list $l2))
  (type $l4 (list $l3))
  (type $l5 (list $l4))
  (type $l6 (list $l5))
  (type $l7 (list $l6))
  (type $l8 (list $l7))
  (type $l9 (list $l8))
  (type $l10 (list $l9))
  (type $l11 (list $l10))
  (type $l12 (list $l11))
  (type $l13 (list $l12))
  (type $l14 (list $l13))
  (type $l15 (list $l14))
  (type $l16 (list $l15))
  (type $l17 (list $l16))
  (type $l18 (list $l17))
  (type $l19 (list $l18))
  (type $l20 (list $l19))
  (type $l21 (list $l20))
  (type $l22 (list $l21))
  (type $l23 (list $l22))
  (type $l24 (list $l23))
  (type $l25 (list $l24))
  (type $l26 (list $l25))
  (type $l27 (list $l26))
  (type $l28 (list $l27))
  (type $l29 (list $l28))
  (type $l30 (list $l29))
  (type $l31 (list $l30))
  (type $l32 (list $l31))
  (type $l33 (list $l32))
  (type $l34 (list $l33))
  (type $l35 (list $l34))
  (type $l36 (list $l35))
  (type $l37 (list $l36))
  (type $l38 (list $l37))
  (type $l39 (list $l38))
  (type $l40 (list $l39))
  (type $l41 (list $l40))
  (type $l42 (list $l41))
  (type $l43 (list $l42))
  (type $l44 (list $l43))
  (type $l45 (list $l44))
  (type $l46 (list $l45))
  (type $l47 (list $l46))
  (type $l48 (list $l47))
  (type $l49 (list $l48))
  (type $l50 (list $l49))
  (import "echo-list-record" (func $echo-list-record (param "x" (list $tagged)) (result (list $tagged))))
  (import "echo-option-list" (func $echo-option-list (param "x" (option (list (option u32)))) (result (option (list (option u32))))))
  (import "echo-shape" (func $echo-shape (param "x" $shape) (result $shape)))
  (import "echo-tuple" (func $echo-tuple (param "x" (tuple string (list u8) (option char))) (result (tuple string (list u8) (option char)))))
  (import "echo-results" (func $echo-results (param "x" (list (result $point (error (list string))))) (result (list (result $point (error (list string)))))))
  (import "echo-deep" (func $echo-deep (param "x" $l50) (result $l50)))
  (import "echo-web-page" (func $echo-web-page (param "x" $web-page) (result $web-page)))

  (core module $Memory
    (memory (export "mem") 1)
    (global $next (mut i32) (i32.const 16))
    (func (export "realloc") (param $old i32) (param $old-size i32) (param $align i32) (param $new-size i32) (result i32)
      (local $ptr i32) (local $pages i32)
      (local.set $ptr
        (i32.and
          (i32.add (global.get $next) (i32.sub (local.get $align) (i32.const 1)))
          (i32.sub (i32.const 0) (local.get $align))))
      (global.set $next (i32.add (local.get $ptr) (local.get $new-size)))
      (local.set $pages
        (i32.sub
          (i32.shr_u (i32.add (global.get $next) (i32.const 65535)) (i32.const 16))
          (memory.size)))
      (if (i32.gt_s (local.get $pages) (i32.const 0))
        (then (drop (memory.grow (local.get $pages)))))
      (if (local.get $old)
        (then (memory.copy (local.get $ptr) (local.get $old) (select (local.get $old-size) (local.get $new-size) (i32.lt_u (local.get $old-size) (local.get $new-size))))))
      (local.get $ptr)))
  (core instance $memory (instantiate $Memory))

  (core func $echo-list-record' (canon lower (func $echo-list-record) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $echo-option-list' (canon lower (func $echo-option-list) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $echo-shape' (canon lower (func $echo-shape) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $echo-tuple' (canon lower (func $echo-tuple) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $echo-results' (canon lower (func $echo-results) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $echo-deep' (canon lower (func $echo-deep) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $echo-web-page' (canon lower (func $echo-web-page) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))

  (core module $M
    (import "" "mem" (memory 1))
    (import "" "realloc" (func $realloc (param i32 i32 i32 i32) (result i32)))
    (import "" "echo-list-record" (func $echo-list-record (param i32 i32 i32)))
    (import "" "echo-option-list" (func $echo-option-list (param i32 i32 i32 i32)))
    (import "" "echo-shape" (func $echo-shape (param i32 i32 i32 i32)))
    (import "" "echo-tuple" (func $echo-tuple (param i32 i32 i32 i32 i32 i32 i32)))
    (import "" "echo-results" (func $echo-results (param i32 i32 i32)))
    (import "" "echo-deep" (func $echo-deep (param i32 i32 i32)))
    (import "" "echo-web-page" (func $echo-web-page (param i32 i32 i32 i32 i32 i32 i32)))
    (func (export "roundtrip-list-record") (param i32 i32) (result i32)
      (local $ret i32)
      (local.set $ret (call $realloc (i32.const 0) (i32.const 0) (i32.const 8) (i32.const 256)))
      (call $echo-list-record (local.get 0) (local.get 1) (local.get $ret))
      (local.get $ret))
    (func (export "roundtrip-option-list") (param i32 i32 i32) (result i32)
      (local $ret i32)
      (local.set $ret (call $realloc (i32.const 0) (i32.const 0) (i32.const 8) (i32.const 256)))
      (call $echo-option-list (local.get 0) (local.get 1) (local.get 2) (local.get $ret))
      (local.get $ret))
    (func (export "roundtrip-shape") (param i32 i32 i32) (result i32)
      (local $ret i32)
      (local.set $ret (call $realloc (i32.const 0) (i32.const 0) (i32.const 8) (i32.const 256)))
      (call $echo-shape (local.get 0) (local.get 1) (local.get 2) (local.get $ret))
      (local.get $ret))
    (func (export "roundtrip-tuple") (param i32 i32 i32 i32 i32 i32) (result i32)
      (local $ret i32)
      (local.set $ret (call $realloc (i32.const 0) (i32.const 0) (i32.const 8) (i32.const 256)))
      (call $echo-tuple (local.get 0) (local.get 1) (local.get 2) (local.get 3) (local.get 4) (local.get 5) (local.get $ret))
      (local.get $ret))
    (func (export "roundtrip-results") (param i32 i32) (result i32)
      (local $ret i32)
      (local.set $ret (call $realloc (i32.const 0) (i32.const 0) (i32.const 8) (i32.const 256)))
      (call $echo-results (local.get 0) (local.get 1) (local.get $ret))
      (local.get $ret))
    (func (export "roundtrip-deep") (param i32 i32) (result i32)
      (local $ret i32)
      (local.set $ret (call $realloc (i32.const 0) (i32.const 0) (i32.const 8) (i32.const 256)))
      (call $echo-deep (local.get 0) (local.get 1) (local.get $ret))
      (local.get $ret))
    (func (export "roundtrip-web-page") (param i32 i32 i32 i32 i32 i32) (result i32)
      (local $ret i32)
      (local.set $ret (call $realloc (i32.const 0) (i32.const 0) (i32.const 8) (i32.const 256)))
      (call $echo-web-page (local.get 0) (local.get 1) (local.get 2) (local.get 3) (local.get 4) (local.get 5) (local.get $ret))
      (local.get $ret))
  )
  (core instance $m (instantiate $M (with "" (instance
    (export "mem" (memory $memory "mem"))
    (export "realloc" (func $memory "realloc"))
    (export "echo-list-record" (func $echo-list-record'))
    (export "echo-option-list" (func $echo-option-list'))
    (export "echo-shape" (func $echo-shape'))
    (export "echo-tuple" (func $echo-tuple'))
    (export "echo-results" (func $echo-results'))
    (export "echo-deep" (func $echo-deep'))
    (export "echo-web-page" (func $echo-web-page'))
  ))))

  (func $roundtrip-list-record (param "x" (list $tagged)) (result (list $tagged))
    (canon lift (core func $m "roundtrip-list-record")
      (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (export "roundtrip-list-record" (func $roundtrip-list-record))
  (func $roundtrip-option-list (param "x" (option (list (option u32)))) (result (option (list (option u32))))
    (canon lift (core func $m "roundtrip-option-list")
      (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (export "roundtrip-option-list" (func $roundtrip-option-list))
  (func $roundtrip-shape (param "x" $shape) (result $shape)
    (canon lift (core func $m "roundtrip-shape")
      (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (export "roundtrip-shape" (func $roundtrip-shape))
  (func $roundtrip-tuple (param "x" (tuple string (list u8) (option char))) (result (tuple string (list u8) (option char)))
    (canon lift (core func $m "roundtrip-tuple")
      (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (export "roundtrip-tuple" (func $roundtrip-tuple))
  (func $roundtrip-results (param "x" (list (result $point (error (list string))))) (result (list (result $point (error (list string)))))
    (canon lift (core func $m "roundtrip-results")
      (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (export "roundtrip-results" (func $roundtrip-results))
  (func $roundtrip-deep (param "x" $l50) (result $l50)
    (canon lift (core func $m "roundtrip-deep")
      (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (export "roundtrip-deep" (func $roundtrip-deep))
  (func $roundtrip-web-page (param "x" $web-page) (result $web-page)
    (canon lift (core func $m "roundtrip-web-page")
      (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (export "roundtrip-web-page" (func $roundtrip-web-page))
)
