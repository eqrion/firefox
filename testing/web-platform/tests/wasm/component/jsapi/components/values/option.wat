;; Passthrough for option<T> with several payload types, including
;; option<option<T>>, whose inner option takes the variant form in JS.
(component
  (import "echo-u32" (func $echo-u32 (param "x" (option u32)) (result (option u32))))
  (import "echo-string" (func $echo-string (param "x" (option string)) (result (option string))))
  (import "echo-nested" (func $echo-nested (param "x" (option (option u32))) (result (option (option u32)))))
  (import "echo-bool" (func $echo-bool (param "x" (option bool)) (result (option bool))))

  (core module $Memory
    (memory (export "mem") 1)
    (global $next (mut i32) (i32.const 16))
    (func (export "realloc") (param $old i32) (param $old-size i32) (param $align i32) (param $new-size i32) (result i32)
      (local $ptr i32) (local $pages i32)
      (local.set $ptr
        (i32.and
          (i32.add (global.get $next) (i32.sub (local.get $align) (i32.const 1)))
          (i32.sub (i32.const 0) (local.get $align))))
      (global.set $next (i32.add (local.get $ptr) (local.get $new-size)))
      (local.set $pages
        (i32.sub
          (i32.shr_u (i32.add (global.get $next) (i32.const 65535)) (i32.const 16))
          (memory.size)))
      (if (i32.gt_s (local.get $pages) (i32.const 0))
        (then (drop (memory.grow (local.get $pages)))))
      (if (local.get $old)
        (then (memory.copy (local.get $ptr) (local.get $old) (select (local.get $old-size) (local.get $new-size) (i32.lt_u (local.get $old-size) (local.get $new-size))))))
      (local.get $ptr)))
  (core instance $memory (instantiate $Memory))

  (core func $echo-u32' (canon lower (func $echo-u32) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $echo-string' (canon lower (func $echo-string) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $echo-nested' (canon lower (func $echo-nested) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $echo-bool' (canon lower (func $echo-bool) (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))

  (core module $M
    (import "" "mem" (memory 1))
    (import "" "realloc" (func $realloc (param i32 i32 i32 i32) (result i32)))
    (import "" "echo-u32" (func $echo-u32 (param i32 i32 i32)))
    (import "" "echo-string" (func $echo-string (param i32 i32 i32 i32)))
    (import "" "echo-nested" (func $echo-nested (param i32 i32 i32 i32)))
    (import "" "echo-bool" (func $echo-bool (param i32 i32 i32)))
    (func (export "roundtrip-u32") (param i32 i32) (result i32)
      (local $ret i32)
      (local.set $ret (call $realloc (i32.const 0) (i32.const 0) (i32.const 8) (i32.const 256)))
      (call $echo-u32 (local.get 0) (local.get 1) (local.get $ret))
      (local.get $ret))
    (func (export "roundtrip-string") (param i32 i32 i32) (result i32)
      (local $ret i32)
      (local.set $ret (call $realloc (i32.const 0) (i32.const 0) (i32.const 8) (i32.const 256)))
      (call $echo-string (local.get 0) (local.get 1) (local.get 2) (local.get $ret))
      (local.get $ret))
    (func (export "roundtrip-nested") (param i32 i32 i32) (result i32)
      (local $ret i32)
      (local.set $ret (call $realloc (i32.const 0) (i32.const 0) (i32.const 8) (i32.const 256)))
      (call $echo-nested (local.get 0) (local.get 1) (local.get 2) (local.get $ret))
      (local.get $ret))
    (func (export "roundtrip-bool") (param i32 i32) (result i32)
      (local $ret i32)
      (local.set $ret (call $realloc (i32.const 0) (i32.const 0) (i32.const 8) (i32.const 256)))
      (call $echo-bool (local.get 0) (local.get 1) (local.get $ret))
      (local.get $ret))
  )
  (core instance $m (instantiate $M (with "" (instance
    (export "mem" (memory $memory "mem"))
    (export "realloc" (func $memory "realloc"))
    (export "echo-u32" (func $echo-u32'))
    (export "echo-string" (func $echo-string'))
    (export "echo-nested" (func $echo-nested'))
    (export "echo-bool" (func $echo-bool'))
  ))))

  (func $roundtrip-u32 (param "x" (option u32)) (result (option u32))
    (canon lift (core func $m "roundtrip-u32")
      (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (export "roundtrip-u32" (func $roundtrip-u32))
  (func $roundtrip-string (param "x" (option string)) (result (option string))
    (canon lift (core func $m "roundtrip-string")
      (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (export "roundtrip-string" (func $roundtrip-string))
  (func $roundtrip-nested (param "x" (option (option u32))) (result (option (option u32)))
    (canon lift (core func $m "roundtrip-nested")
      (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (export "roundtrip-nested" (func $roundtrip-nested))
  (func $roundtrip-bool (param "x" (option bool)) (result (option bool))
    (canon lift (core func $m "roundtrip-bool")
      (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (export "roundtrip-bool" (func $roundtrip-bool))
)
