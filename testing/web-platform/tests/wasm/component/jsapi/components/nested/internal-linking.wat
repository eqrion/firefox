;; $A defines a `counter` resource. $B imports $A's instance directly, along
;; with a host resource threaded through from the outer component's imports.
;; The outer component exports pieces of both.
(component
  (import "host" (type $host (sub resource)))
  (import "[method]host.ping" (func $ping (param "self" (borrow $host)) (result u32)))

  (component $A
    (core module $Indirect
      (table (export "ftbl") 1 funcref)
      (type $FT (func (param i32)))
      (func (export "dtor") (param i32)
        (call_indirect (type $FT) (local.get 0) (i32.const 0))))
    (core instance $indirect (instantiate $Indirect))
    (type $counter (resource (rep i32) (dtor (core func $indirect "dtor"))))
    (core func $new (canon resource.new $counter))
    (core module $M
      (import "" "ftbl" (table 1 funcref))
      (import "" "new" (func $new (param i32) (result i32)))
      (memory 1)
      (global $next (mut i32) (i32.const 0))
      (global $drops (mut i32) (i32.const 0))
      (func (export "ctor") (param $start i32) (result i32)
        (local $ptr i32)
        (local.set $ptr (global.get $next))
        (global.set $next (i32.add (local.get $ptr) (i32.const 4)))
        (i32.store (local.get $ptr) (local.get $start))
        (call $new (local.get $ptr)))
      (func (export "increment") (param $ptr i32) (result i32)
        (i32.store (local.get $ptr) (i32.add (i32.load (local.get $ptr)) (i32.const 1)))
        (i32.load (local.get $ptr)))
      (func (export "drop-count") (result i32) (global.get $drops))
      (func $dtor (param i32)
        (global.set $drops (i32.add (global.get $drops) (i32.const 1))))
      (elem (i32.const 0) $dtor))
    (core instance $m (instantiate $M (with "" (instance
      (export "ftbl" (table $indirect "ftbl"))
      (export "new" (func $new))))))
    (func $ctor (param "start" u32) (result (own $counter)) (canon lift (core func $m "ctor")))
    (func $increment (param "self" (borrow $counter)) (result u32) (canon lift (core func $m "increment")))
    (func $drop-count (result u32) (canon lift (core func $m "drop-count")))
    (export $counter' "counter" (type $counter))
    (export "[constructor]counter" (func $ctor) (func (param "start" u32) (result (own $counter'))))
    (export "[method]counter.increment" (func $increment) (func (param "self" (borrow $counter')) (result u32)))
    (export "drop-count" (func $drop-count)))

  (component $B
    (import "a" (instance $a
      (export "counter" (type $counter (sub resource)))
      (export "[constructor]counter" (func (param "start" u32) (result (own $counter))))
      (export "[method]counter.increment" (func (param "self" (borrow $counter)) (result u32)))))
    (import "host" (type $host (sub resource)))
    (import "[method]host.ping" (func $ping (param "self" (borrow $host)) (result u32)))
    (alias export $a "counter" (type $counter))
    (core func $ctor' (canon lower (func $a "[constructor]counter")))
    (core func $increment' (canon lower (func $a "[method]counter.increment")))
    (core func $drop-counter (canon resource.drop $counter))
    (core func $ping' (canon lower (func $ping)))
    (core func $drop-host (canon resource.drop $host))
    (core module $M
      (import "" "ctor" (func $ctor (param i32) (result i32)))
      (import "" "increment" (func $increment (param i32) (result i32)))
      (import "" "drop-counter" (func $drop-counter (param i32)))
      (import "" "ping" (func $ping (param i32) (result i32)))
      (import "" "drop-host" (func $drop-host (param i32)))
      (func (export "make-and-increment") (param $start i32) (result i32)
        (local $h i32) (local $v i32)
        (local.set $h (call $ctor (local.get $start)))
        (drop (call $increment (local.get $h)))
        (local.set $v (call $increment (local.get $h)))
        (call $drop-counter (local.get $h))
        (local.get $v))
      (func (export "ping-twice") (param $h i32) (result i32)
        (local $v i32)
        (local.set $v (i32.add (call $ping (local.get $h)) (call $ping (local.get $h))))
        (call $drop-host (local.get $h))
        (local.get $v)))
    (core instance $m (instantiate $M (with "" (instance
      (export "ctor" (func $ctor'))
      (export "increment" (func $increment'))
      (export "drop-counter" (func $drop-counter))
      (export "ping" (func $ping'))
      (export "drop-host" (func $drop-host))))))
    (func $make-and-increment (param "start" u32) (result u32) (canon lift (core func $m "make-and-increment")))
    (func $ping-twice (param "h" (borrow $host)) (result u32) (canon lift (core func $m "ping-twice")))
    (export "make-and-increment" (func $make-and-increment))
    (export "ping-twice" (func $ping-twice)))

  (instance $a (instantiate $A))
  (instance $b (instantiate $B
    (with "a" (instance $a))
    (with "host" (type $host))
    (with "[method]host.ping" (func $ping))))

  (alias export $a "counter" (type $counter))
  (export $counter' "counter" (type $counter))
  (export "[constructor]counter" (func $a "[constructor]counter")
    (func (param "start" u32) (result (own $counter'))))
  (export "[method]counter.increment" (func $a "[method]counter.increment")
    (func (param "self" (borrow $counter')) (result u32)))
  (export "drop-count" (func $a "drop-count"))
  (export "make-and-increment" (func $b "make-and-increment"))
  (export "ping-twice" (func $b "ping-twice"))
)
