;; The standard guest resource: a counter whose rep is a byte offset in the
;; core module's memory. The destructor lives in a separate module so it can be
;; referenced before the main module is instantiated; it bumps a counter that
;; `drop-count` exposes so JS can observe destruction.
(component
  (import "notify" (func $notify (param "value" u32)))

  (core module $Dtor
    (global $count (mut i32) (i32.const 0))
    (func (export "dtor") (param i32)
      (global.set $count (i32.add (global.get $count) (i32.const 1))))
    (func (export "drop-count") (result i32) (global.get $count)))
  (core instance $dtor (instantiate $Dtor))

  (type $counter (resource (rep i32) (dtor (core func $dtor "dtor"))))
  (core func $resource.new (canon resource.new $counter))
  (core func $resource.drop (canon resource.drop $counter))
  (core func $notify' (canon lower (func $notify)))

  (core module $CM
    (import "" "resource.new" (func $resource.new (param i32) (result i32)))
    (import "" "resource.drop" (func $resource.drop (param i32)))
    (import "" "notify" (func $notify (param i32)))
    (memory (export "mem") 1)
    (global $next (mut i32) (i32.const 1024))

    (func $alloc (param $size i32) (param $align i32) (result i32)
      (local $ptr i32) (local $pages i32)
      (local.set $ptr
        (i32.and
          (i32.add (global.get $next) (i32.sub (local.get $align) (i32.const 1)))
          (i32.sub (i32.const 0) (local.get $align))))
      (global.set $next (i32.add (local.get $ptr) (local.get $size)))
      (local.set $pages
        (i32.sub
          (i32.shr_u (i32.add (global.get $next) (i32.const 65535)) (i32.const 16))
          (memory.size)))
      (if (i32.gt_s (local.get $pages) (i32.const 0))
        (then (drop (memory.grow (local.get $pages)))))
      (local.get $ptr))
    (func (export "realloc") (param $old i32) (param $old-size i32) (param $align i32) (param $new-size i32) (result i32)
      (local $ptr i32)
      (local.set $ptr (call $alloc (local.get $new-size) (local.get $align)))
      (if (local.get $old)
        (then (memory.copy (local.get $ptr) (local.get $old) (select (local.get $old-size) (local.get $new-size) (i32.lt_u (local.get $old-size) (local.get $new-size))))))
      (local.get $ptr))

    (func $new-counter (param $start i32) (result i32)
      (local $rep i32)
      (local.set $rep (call $alloc (i32.const 4) (i32.const 4)))
      (i32.store (local.get $rep) (local.get $start))
      (call $resource.new (local.get $rep)))

    (func (export "ctor") (param i32) (result i32) (call $new-counter (local.get 0)))
    (func (export "increment") (param $rep i32) (result i32)
      (i32.store (local.get $rep) (i32.add (i32.load (local.get $rep)) (i32.const 1)))
      (i32.load (local.get $rep)))
    (func (export "value") (param $rep i32) (result i32) (i32.load (local.get $rep)))
    (func (export "clone") (param $rep i32) (result i32) (call $new-counter (i32.load (local.get $rep))))
    (func (export "notify") (param $rep i32) (call $notify (i32.load (local.get $rep))))
    (func (export "make") (result i32) (call $new-counter (i32.const 0)))
    (func (export "take") (param $h i32) (call $resource.drop (local.get $h)))
    (func (export "peek") (param $rep i32) (result i32) (i32.load (local.get $rep)))
    (func (export "peek-pair") (param $a i32) (param $b i32) (result i32)
      (i32.add (i32.load (local.get $a)) (i32.load (local.get $b))))
    (func (export "take-both") (param $rep i32) (param $h i32) (call $resource.drop (local.get $h)))
    (func (export "take-then-borrow") (param $h i32) (param $rep i32) (call $resource.drop (local.get $h)))
    (func (export "make-pair") (result i32)
      (local $ret i32)
      (local.set $ret (call $alloc (i32.const 8) (i32.const 4)))
      (i32.store (local.get $ret) (call $new-counter (i32.const 1)))
      (i32.store offset=4 (local.get $ret) (call $new-counter (i32.const 2)))
      (local.get $ret))
    (func (export "same-rep") (result i32) (call $resource.new (i32.const 16)))
    (func (export "borrow-and-notify") (param $rep i32) (call $notify (i32.load (local.get $rep))))
    (func (export "take-list") (param $ptr i32) (param $len i32) (result i32)
      (local $i i32)
      (block $done
        (loop $loop
          (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
          (call $resource.drop (i32.load (i32.add (local.get $ptr) (i32.mul (local.get $i) (i32.const 4)))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $loop)))
      (local.get $len)))
  (core instance $cm (instantiate $CM (with "" (instance
    (export "resource.new" (func $resource.new))
    (export "resource.drop" (func $resource.drop))
    (export "notify" (func $notify'))))))

  (export $counter' "counter" (type $counter))

  (func $ctor (param "start" u32) (result (own $counter')) (canon lift (core func $cm "ctor")))
  (export "[constructor]counter" (func $ctor))
  (func $increment (param "self" (borrow $counter')) (result u32) (canon lift (core func $cm "increment")))
  (export "[method]counter.increment" (func $increment))
  (func $value (param "self" (borrow $counter')) (result u32) (canon lift (core func $cm "value")))
  (export "[method]counter.value" (func $value))
  (func $clone (param "self" (borrow $counter')) (result (own $counter')) (canon lift (core func $cm "clone")))
  (export "[method]counter.clone" (func $clone))
  (func $method-notify (param "self" (borrow $counter')) (canon lift (core func $cm "notify")))
  (export "[method]counter.notify" (func $method-notify))
  (func $create (param "start" u32) (result (own $counter')) (canon lift (core func $cm "ctor")))
  (export "[static]counter.create" (func $create))

  (func $drop-count (result u32) (canon lift (core func $dtor "drop-count")))
  (export "drop-count" (func $drop-count))
  (func $make (result (own $counter')) (canon lift (core func $cm "make")))
  (export "make" (func $make))
  (func $take (param "c" (own $counter')) (canon lift (core func $cm "take")))
  (export "take" (func $take))
  (func $peek (param "c" (borrow $counter')) (result u32) (canon lift (core func $cm "peek")))
  (export "peek" (func $peek))
  (func $peek-pair (param "a" (borrow $counter')) (param "b" (borrow $counter')) (result u32) (canon lift (core func $cm "peek-pair")))
  (export "peek-pair" (func $peek-pair))
  (func $take-both (param "a" (borrow $counter')) (param "b" (own $counter')) (canon lift (core func $cm "take-both")))
  (export "take-both" (func $take-both))
  (func $take-then-borrow (param "a" (own $counter')) (param "b" (borrow $counter')) (canon lift (core func $cm "take-then-borrow")))
  (export "take-then-borrow" (func $take-then-borrow))
  (func $make-pair (result (tuple (own $counter') (own $counter')))
    (canon lift (core func $cm "make-pair") (memory (core memory $cm "mem")) (realloc (core func $cm "realloc"))))
  (export "make-pair" (func $make-pair))
  (func $same-rep (result (own $counter')) (canon lift (core func $cm "same-rep")))
  (export "same-rep" (func $same-rep))
  (func $borrow-and-notify (param "c" (borrow $counter')) (canon lift (core func $cm "borrow-and-notify")))
  (export "borrow-and-notify" (func $borrow-and-notify))
  (func $take-list (param "l" (list (own $counter'))) (result u32)
    (canon lift (core func $cm "take-list") (memory (core memory $cm "mem")) (realloc (core func $cm "realloc"))))
  (export "take-list" (func $take-list))
)
