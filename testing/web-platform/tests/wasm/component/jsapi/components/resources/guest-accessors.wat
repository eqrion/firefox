;; A guest resource with `[get]`/`[set]` members on the prototype and the
;; class. Needs wasm-tools with getter/setter support (wasm-tools#2660).
(component
  (type $counter (resource (rep i32)))
  (core func $resource.new (canon resource.new $counter))
  (core func $resource.rep (canon resource.rep $counter))

  (core module $CM
    (import "" "resource.new" (func $resource.new (param i32) (result i32)))
    (memory (export "mem") 1)
    (global $next (mut i32) (i32.const 1024))
    (global $instances (mut i32) (i32.const 0))
    (func (export "ctor") (param $start i32) (result i32)
      (local $rep i32)
      (local.set $rep (global.get $next))
      (global.set $next (i32.add (local.get $rep) (i32.const 4)))
      (i32.store (local.get $rep) (local.get $start))
      (global.set $instances (i32.add (global.get $instances) (i32.const 1)))
      (call $resource.new (local.get $rep)))
    (func (export "get-value") (param $rep i32) (result i32) (i32.load (local.get $rep)))
    (func (export "set-value") (param $rep i32) (param $v i32) (i32.store (local.get $rep) (local.get $v)))
    (func (export "get-doubled") (param $rep i32) (result i32) (i32.mul (i32.load (local.get $rep)) (i32.const 2)))
    (func (export "get-instances") (result i32) (global.get $instances))
    (func (export "set-instances") (param $v i32) (global.set $instances (local.get $v)))
    (func (export "get-version") (result i32) (i32.const 7)))
  (core instance $cm (instantiate $CM (with "" (instance
    (export "resource.new" (func $resource.new))))))

  (export $counter' "counter" (type $counter))
  (func $ctor (param "start" u32) (result (own $counter')) (canon lift (core func $cm "ctor")))
  (export "[constructor]counter" (func $ctor))
  (func $get-value (param "self" (borrow $counter')) (result u32) (canon lift (core func $cm "get-value")))
  (export "[method][get]counter.value" (func $get-value))
  (func $set-value (param "self" (borrow $counter')) (param "value" u32) (canon lift (core func $cm "set-value")))
  (export "[method][set]counter.value" (func $set-value))
  (func $get-doubled (param "self" (borrow $counter')) (result u32) (canon lift (core func $cm "get-doubled")))
  (export "[method][get]counter.doubled" (func $get-doubled))
  (func $get-instances (result u32) (canon lift (core func $cm "get-instances")))
  (export "[static][get]counter.instances" (func $get-instances))
  (func $set-instances (param "value" u32) (canon lift (core func $cm "set-instances")))
  (export "[static][set]counter.instances" (func $set-instances))
  (func $get-version (result u32) (canon lift (core func $cm "get-version")))
  (export "[static][get]counter.version" (func $get-version))
)
