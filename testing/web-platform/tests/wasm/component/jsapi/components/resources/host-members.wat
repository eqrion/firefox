;; `[constructor]`, `[method]` and `[static]` imports of a host resource,
;; each forwarded by an export so JS can observe how they are invoked.
(component
  (import "r" (type $r (sub resource)))
  (import "[constructor]r" (func $ctor (param "x" u32) (result (own $r))))
  (import "[method]r.add" (func $add (param "self" (borrow $r)) (param "n" u32) (result u32)))
  (import "[static]r.create" (func $create (param "x" u32) (result (own $r))))
  (core func $ctor' (canon lower (func $ctor)))
  (core func $add' (canon lower (func $add)))
  (core func $create' (canon lower (func $create)))
  (core func $drop-r (canon resource.drop $r))
  (core module $M
    (import "" "ctor" (func $ctor (param i32) (result i32)))
    (import "" "add" (func $add (param i32 i32) (result i32)))
    (import "" "create" (func $create (param i32) (result i32)))
    (import "" "drop-r" (func $drop-r (param i32)))
    (func (export "construct") (param i32) (result i32) (call $ctor (local.get 0)))
    (func (export "call-add") (param i32 i32) (result i32) (local $result i32)
      (local.set $result (call $add (local.get 0) (local.get 1)))
      (call $drop-r (local.get 0))
      (local.get $result))
    (func (export "call-create") (param i32) (result i32) (call $create (local.get 0))))
  (core instance $m (instantiate $M (with "" (instance
    (export "ctor" (func $ctor'))
    (export "add" (func $add'))
    (export "create" (func $create'))
    (export "drop-r" (func $drop-r))))))
  (func $construct (param "x" u32) (result (own $r)) (canon lift (core func $m "construct")))
  (func $call-add (param "target" (borrow $r)) (param "n" u32) (result u32) (canon lift (core func $m "call-add")))
  (func $call-create (param "x" u32) (result (own $r)) (canon lift (core func $m "call-create")))
  (export "construct" (func $construct))
  (export "call-add" (func $call-add))
  (export "call-create" (func $call-create))
)
