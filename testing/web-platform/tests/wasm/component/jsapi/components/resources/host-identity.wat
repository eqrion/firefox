;; Threads host resource values through params, results, an import and
;; containers so JS can check it always gets the same object back.
(component
  (import "r" (type $r (sub resource)))
  (import "recv" (func $recv (param "x" (borrow $r))))
  (core func $recv' (canon lower (func $recv)))
  (core func $drop-r (canon resource.drop $r))
  (core module $M
    (import "" "recv" (func $recv (param i32)))
    (import "" "drop-r" (func $drop-r (param i32)))
    (memory (export "mem") 1)
    (global $next (mut i32) (i32.const 64))
    (global $stored (mut i32) (i32.const 0))
    (func (export "realloc") (param $old i32) (param $old-size i32) (param $align i32) (param $new-size i32) (result i32)
      (local $ptr i32) (local $pages i32)
      (local.set $ptr
        (i32.and
          (i32.add (global.get $next) (i32.sub (local.get $align) (i32.const 1)))
          (i32.sub (i32.const 0) (local.get $align))))
      (global.set $next (i32.add (local.get $ptr) (local.get $new-size)))
      (local.set $pages
        (i32.sub
          (i32.shr_u (i32.add (global.get $next) (i32.const 65535)) (i32.const 16))
          (memory.size)))
      (if (i32.gt_s (local.get $pages) (i32.const 0))
        (then (drop (memory.grow (local.get $pages)))))
      (if (local.get $old)
        (then (memory.copy (local.get $ptr) (local.get $old) (select (local.get $old-size) (local.get $new-size) (i32.lt_u (local.get $old-size) (local.get $new-size))))))
      (local.get $ptr))
    (func $ret2 (param $a i32) (param $b i32) (result i32)
      (i32.store (i32.const 0) (local.get $a))
      (i32.store (i32.const 4) (local.get $b))
      (i32.const 0))
    (func (export "send") (param i32) (call $recv (local.get 0)) (call $drop-r (local.get 0)))
    (func (export "store") (param i32) (global.set $stored (local.get 0)))
    (func (export "load") (result i32) (global.get $stored))
    (func (export "roundtrip-list") (param i32 i32) (result i32) (call $ret2 (local.get 0) (local.get 1)))
    (func (export "roundtrip-option") (param i32 i32) (result i32) (call $ret2 (local.get 0) (local.get 1)))
    (func (export "roundtrip-record") (param i32 i32) (result i32) (call $ret2 (local.get 0) (local.get 1)))
    (func (export "roundtrip-variant") (param i32 i32) (result i32) (call $ret2 (local.get 0) (local.get 1)))
    (func (export "roundtrip-map") (param i32 i32) (result i32) (call $ret2 (local.get 0) (local.get 1)))
    (func (export "fail") (param i32) (result i32) (call $ret2 (i32.const 1) (local.get 0))))
  (core instance $m (instantiate $M (with "" (instance
    (export "recv" (func $recv'))
    (export "drop-r" (func $drop-r))))))

  (type $rec' (record (field "a" (own $r)) (field "b" u32)))
  (type $var' (variant (case "none") (case "some" (own $r))))
  (export $rec "rec" (type $rec'))
  (export $var "var" (type $var'))
  (func $send (param "x" (borrow $r)) (canon lift (core func $m "send")))
  (func $store (param "x" (own $r)) (canon lift (core func $m "store")))
  (func $load (result (own $r)) (canon lift (core func $m "load")))
  (func $roundtrip-list (param "x" (list (own $r))) (result (list (own $r)))
    (canon lift (core func $m "roundtrip-list") (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  (func $roundtrip-option (param "x" (option (own $r))) (result (option (own $r)))
    (canon lift (core func $m "roundtrip-option") (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  (func $roundtrip-record (param "x" $rec) (result $rec)
    (canon lift (core func $m "roundtrip-record") (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  (func $roundtrip-variant (param "x" $var) (result $var)
    (canon lift (core func $m "roundtrip-variant") (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  (func $roundtrip-map (param "x" (map string (own $r))) (result (map string (own $r)))
    (canon lift (core func $m "roundtrip-map") (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  (func $fail (param "x" (own $r)) (result (result u32 (error (own $r))))
    (canon lift (core func $m "fail") (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  (export "send" (func $send))
  (export "store" (func $store))
  (export "load" (func $load))
  (export "roundtrip-list" (func $roundtrip-list))
  (export "roundtrip-option" (func $roundtrip-option))
  (export "roundtrip-record" (func $roundtrip-record))
  (export "roundtrip-variant" (func $roundtrip-variant))
  (export "roundtrip-map" (func $roundtrip-map))
  (export "fail" (func $fail))
)
