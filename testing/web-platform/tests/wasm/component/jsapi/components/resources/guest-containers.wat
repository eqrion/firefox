;; Guest resources inside container types, in both directions. `wrap-*`
;; exports produce containers holding fresh counters; `unwrap-*` exports
;; consume them, returning a value derived from the counters and dropping them.
(component
  (core module $Dtor
    (global $count (mut i32) (i32.const 0))
    (func (export "dtor") (param i32)
      (global.set $count (i32.add (global.get $count) (i32.const 1))))
    (func (export "drop-count") (result i32) (global.get $count)))
  (core instance $dtor (instantiate $Dtor))

  (type $counter (resource (rep i32) (dtor (core func $dtor "dtor"))))
  (core func $resource.new (canon resource.new $counter))
  (core func $resource.drop (canon resource.drop $counter))
  (core func $resource.rep (canon resource.rep $counter))

  (core module $CM
    (import "" "resource.new" (func $resource.new (param i32) (result i32)))
    (import "" "resource.drop" (func $resource.drop (param i32)))
    (import "" "resource.rep" (func $resource.rep (param i32) (result i32)))
    (memory (export "mem") 1)
    (data (i32.const 8) "ab")
    (global $next (mut i32) (i32.const 1024))

    (func $alloc (param $size i32) (param $align i32) (result i32)
      (local $ptr i32) (local $pages i32)
      (local.set $ptr
        (i32.and
          (i32.add (global.get $next) (i32.sub (local.get $align) (i32.const 1)))
          (i32.sub (i32.const 0) (local.get $align))))
      (global.set $next (i32.add (local.get $ptr) (local.get $size)))
      (local.set $pages
        (i32.sub
          (i32.shr_u (i32.add (global.get $next) (i32.const 65535)) (i32.const 16))
          (memory.size)))
      (if (i32.gt_s (local.get $pages) (i32.const 0))
        (then (drop (memory.grow (local.get $pages)))))
      (local.get $ptr))
    (func (export "realloc") (param $old i32) (param $old-size i32) (param $align i32) (param $new-size i32) (result i32)
      (local $ptr i32)
      (local.set $ptr (call $alloc (local.get $new-size) (local.get $align)))
      (if (local.get $old)
        (then (memory.copy (local.get $ptr) (local.get $old) (select (local.get $old-size) (local.get $new-size) (i32.lt_u (local.get $old-size) (local.get $new-size))))))
      (local.get $ptr))

    (func $new-counter (param $start i32) (result i32)
      (local $rep i32)
      (local.set $rep (call $alloc (i32.const 4) (i32.const 4)))
      (i32.store (local.get $rep) (local.get $start))
      (call $resource.new (local.get $rep)))
    (func $consume (param $h i32) (result i32)
      (local $v i32)
      (local.set $v (i32.load (call $resource.rep (local.get $h))))
      (call $resource.drop (local.get $h))
      (local.get $v))
    (func $ret2 (param $a i32) (param $b i32) (result i32)
      (local $ret i32)
      (local.set $ret (call $alloc (i32.const 8) (i32.const 4)))
      (i32.store (local.get $ret) (local.get $a))
      (i32.store offset=4 (local.get $ret) (local.get $b))
      (local.get $ret))

    (func (export "make") (result i32) (call $new-counter (i32.const 0)))
    (func (export "take") (param $h i32) (call $resource.drop (local.get $h)))
    (func (export "value") (param $rep i32) (result i32) (i32.load (local.get $rep)))

    (func (export "wrap-list") (param $n i32) (result i32)
      (local $ptr i32) (local $i i32)
      (local.set $ptr (call $alloc (i32.mul (local.get $n) (i32.const 4)) (i32.const 4)))
      (block $done
        (loop $loop
          (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
          (i32.store (i32.add (local.get $ptr) (i32.mul (local.get $i) (i32.const 4)))
                     (call $new-counter (local.get $i)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $loop)))
      (call $ret2 (local.get $ptr) (local.get $n)))
    (func (export "unwrap-list") (param $ptr i32) (param $len i32) (result i32)
      (local $i i32) (local $sum i32)
      (block $done
        (loop $loop
          (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
          (local.set $sum (i32.add (local.get $sum)
            (call $consume (i32.load (i32.add (local.get $ptr) (i32.mul (local.get $i) (i32.const 4)))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $loop)))
      (local.get $sum))

    (func (export "wrap-option") (param $present i32) (result i32)
      (if (result i32) (local.get $present)
        (then (call $ret2 (i32.const 1) (call $new-counter (i32.const 5))))
        (else (call $ret2 (i32.const 0) (i32.const 0)))))
    (func (export "unwrap-option") (param $disc i32) (param $h i32) (result i32)
      (if (result i32) (local.get $disc)
        (then (call $consume (local.get $h)))
        (else (i32.const 0xffff))))

    (func (export "wrap-result") (param $ok i32) (result i32)
      (if (result i32) (local.get $ok)
        (then (call $ret2 (i32.const 0) (call $new-counter (i32.const 1))))
        (else (call $ret2 (i32.const 1) (call $new-counter (i32.const 2))))))
    (func (export "unwrap-result") (param $disc i32) (param $payload i32) (result i32)
      (if (result i32) (local.get $disc)
        (then (i32.add (local.get $payload) (i32.const 1000)))
        (else (call $consume (local.get $payload)))))

    (func (export "wrap-record") (result i32)
      (call $ret2 (call $new-counter (i32.const 3)) (i32.const 7)))
    (func (export "unwrap-record") (param $h i32) (param $n i32) (result i32)
      (i32.add (call $consume (local.get $h)) (local.get $n)))

    (func (export "wrap-variant") (param $full i32) (result i32)
      (if (result i32) (local.get $full)
        (then (call $ret2 (i32.const 1) (call $new-counter (i32.const 9))))
        (else (call $ret2 (i32.const 0) (i32.const 0)))))
    (func (export "unwrap-variant") (param $disc i32) (param $h i32) (result i32)
      (if (result i32) (local.get $disc)
        (then (call $consume (local.get $h)))
        (else (i32.const 0xffff))))

    (func (export "wrap-map") (result i32)
      (local $ptr i32)
      (local.set $ptr (call $alloc (i32.const 24) (i32.const 4)))
      (i32.store (local.get $ptr) (i32.const 8))
      (i32.store offset=4 (local.get $ptr) (i32.const 1))
      (i32.store offset=8 (local.get $ptr) (call $new-counter (i32.const 1)))
      (i32.store offset=12 (local.get $ptr) (i32.const 9))
      (i32.store offset=16 (local.get $ptr) (i32.const 1))
      (i32.store offset=20 (local.get $ptr) (call $new-counter (i32.const 2)))
      (call $ret2 (local.get $ptr) (i32.const 2)))
    (func (export "unwrap-map") (param $ptr i32) (param $len i32) (result i32)
      (local $i i32) (local $sum i32)
      (block $done
        (loop $loop
          (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
          (local.set $sum (i32.add (local.get $sum)
            (call $consume (i32.load offset=8 (i32.add (local.get $ptr) (i32.mul (local.get $i) (i32.const 12)))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $loop)))
      (local.get $sum)))
  (core instance $cm (instantiate $CM (with "" (instance
    (export "resource.new" (func $resource.new))
    (export "resource.drop" (func $resource.drop))
    (export "resource.rep" (func $resource.rep))))))

  (export $counter' "counter" (type $counter))
  (type $rec (record (field "c" (own $counter')) (field "n" u32)))
  (export $rec' "rec" (type $rec))
  (type $var (variant (case "empty") (case "full" (own $counter'))))
  (export $var' "var" (type $var))

  (func $value (param "self" (borrow $counter')) (result u32) (canon lift (core func $cm "value")))
  (export "[method]counter.value" (func $value))
  (func $drop-count (result u32) (canon lift (core func $dtor "drop-count")))
  (export "drop-count" (func $drop-count))
  (func $make (result (own $counter')) (canon lift (core func $cm "make")))
  (export "make" (func $make))
  (func $take (param "c" (own $counter')) (canon lift (core func $cm "take")))
  (export "take" (func $take))

  (func $wrap-list (param "n" u32) (result (list (own $counter')))
    (canon lift (core func $cm "wrap-list") (memory (core memory $cm "mem")) (realloc (core func $cm "realloc"))))
  (export "wrap-list" (func $wrap-list))
  (func $unwrap-list (param "l" (list (own $counter'))) (result u32)
    (canon lift (core func $cm "unwrap-list") (memory (core memory $cm "mem")) (realloc (core func $cm "realloc"))))
  (export "unwrap-list" (func $unwrap-list))

  (func $wrap-option (param "present" bool) (result (option (own $counter')))
    (canon lift (core func $cm "wrap-option") (memory (core memory $cm "mem")) (realloc (core func $cm "realloc"))))
  (export "wrap-option" (func $wrap-option))
  (func $unwrap-option (param "o" (option (own $counter'))) (result u32)
    (canon lift (core func $cm "unwrap-option")))
  (export "unwrap-option" (func $unwrap-option))

  (func $wrap-result (param "ok" bool) (result (result (own $counter') (error (own $counter'))))
    (canon lift (core func $cm "wrap-result") (memory (core memory $cm "mem")) (realloc (core func $cm "realloc"))))
  (export "wrap-result" (func $wrap-result))
  (func $unwrap-result (param "r" (result (own $counter') (error u32))) (result u32)
    (canon lift (core func $cm "unwrap-result")))
  (export "unwrap-result" (func $unwrap-result))

  (func $wrap-record (result $rec')
    (canon lift (core func $cm "wrap-record") (memory (core memory $cm "mem")) (realloc (core func $cm "realloc"))))
  (export "wrap-record" (func $wrap-record))
  (func $unwrap-record (param "r" $rec') (result u32)
    (canon lift (core func $cm "unwrap-record")))
  (export "unwrap-record" (func $unwrap-record))

  (func $wrap-variant (param "full" bool) (result $var')
    (canon lift (core func $cm "wrap-variant") (memory (core memory $cm "mem")) (realloc (core func $cm "realloc"))))
  (export "wrap-variant" (func $wrap-variant))
  (func $unwrap-variant (param "v" $var') (result u32)
    (canon lift (core func $cm "unwrap-variant")))
  (export "unwrap-variant" (func $unwrap-variant))

  (func $wrap-map (result (map string (own $counter')))
    (canon lift (core func $cm "wrap-map") (memory (core memory $cm "mem")) (realloc (core func $cm "realloc"))))
  (export "wrap-map" (func $wrap-map))
  (func $unwrap-map (param "m" (map string (own $counter'))) (result u32)
    (canon lift (core func $cm "unwrap-map") (memory (core memory $cm "mem")) (realloc (core func $cm "realloc"))))
  (export "unwrap-map" (func $unwrap-map))
)
