;; `result` in return position, both directions. Each `call-*` export forwards
;; to the import of the same shape; `succeed`/`fail` produce results in the
;; guest; `result-param` takes a `result` as an ordinary parameter.
(component
  (import "fallible" (func $fallible (param "x" u32) (result (result u32 (error string)))))
  (import "fallible-u32" (func $fallible-u32 (result (result u32 (error u32)))))
  (import "fallible-none" (func $fallible-none (result (result))))
  (import "fallible-no-ok" (func $fallible-no-ok (result (result (error string)))))
  (import "nested" (func $nested (result (result (result u32 (error string)) (error string)))))
  (import "plain" (func $plain (result u32)))

  (core module $Memory
    (memory (export "mem") 1)
    (data (i32.const 1024) "boom")
    (global $next (mut i32) (i32.const 4096))
    (func (export "realloc") (param $old i32) (param $old-size i32) (param $align i32) (param $new-size i32) (result i32)
      (local $ptr i32) (local $pages i32)
      (local.set $ptr
        (i32.and
          (i32.add (global.get $next) (i32.sub (local.get $align) (i32.const 1)))
          (i32.sub (i32.const 0) (local.get $align))))
      (global.set $next (i32.add (local.get $ptr) (local.get $new-size)))
      (local.set $pages
        (i32.sub
          (i32.shr_u (i32.add (global.get $next) (i32.const 65535)) (i32.const 16))
          (memory.size)))
      (if (i32.gt_s (local.get $pages) (i32.const 0))
        (then (drop (memory.grow (local.get $pages)))))
      (if (local.get $old)
        (then (memory.copy (local.get $ptr) (local.get $old) (select (local.get $old-size) (local.get $new-size) (i32.lt_u (local.get $old-size) (local.get $new-size))))))
      (local.get $ptr)))
  (core instance $memory (instantiate $Memory))

  (core func $fallible' (canon lower (func $fallible)
    (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $fallible-u32' (canon lower (func $fallible-u32) (memory (core memory $memory "mem"))))
  (core func $fallible-none' (canon lower (func $fallible-none)))
  (core func $fallible-no-ok' (canon lower (func $fallible-no-ok)
    (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $nested' (canon lower (func $nested)
    (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (core func $plain' (canon lower (func $plain)))

  (core module $M
    (import "" "mem" (memory 1))
    (import "" "realloc" (func $realloc (param i32 i32 i32 i32) (result i32)))
    (import "" "fallible" (func $fallible (param i32 i32)))
    (import "" "fallible-u32" (func $fallible-u32 (param i32)))
    (import "" "fallible-none" (func $fallible-none (result i32)))
    (import "" "fallible-no-ok" (func $fallible-no-ok (param i32)))
    (import "" "nested" (func $nested (param i32)))
    (import "" "plain" (func $plain (result i32)))

    (func $alloc (param $size i32) (result i32)
      (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (local.get $size)))

    (func (export "call-fallible") (param $x i32) (result i32)
      (local $ret i32)
      (local.set $ret (call $alloc (i32.const 12)))
      (call $fallible (local.get $x) (local.get $ret))
      (local.get $ret))
    (func (export "call-fallible-u32") (result i32)
      (local $ret i32)
      (local.set $ret (call $alloc (i32.const 8)))
      (call $fallible-u32 (local.get $ret))
      (local.get $ret))
    (func (export "call-fallible-none") (result i32)
      (call $fallible-none))
    (func (export "call-fallible-no-ok") (result i32)
      (local $ret i32)
      (local.set $ret (call $alloc (i32.const 12)))
      (call $fallible-no-ok (local.get $ret))
      (local.get $ret))
    (func (export "call-nested") (result i32)
      (local $ret i32)
      (local.set $ret (call $alloc (i32.const 16)))
      (call $nested (local.get $ret))
      (local.get $ret))
    (func (export "call-plain") (result i32)
      (call $plain))

    ;; ok(7)
    (func (export "succeed") (result i32)
      (local $ret i32)
      (local.set $ret (call $alloc (i32.const 12)))
      (i32.store8 (local.get $ret) (i32.const 0))
      (i32.store offset=4 (local.get $ret) (i32.const 7))
      (local.get $ret))
    ;; error("boom")
    (func (export "fail") (result i32)
      (local $ret i32)
      (local.set $ret (call $alloc (i32.const 12)))
      (i32.store8 (local.get $ret) (i32.const 1))
      (i32.store offset=4 (local.get $ret) (i32.const 1024))
      (i32.store offset=8 (local.get $ret) (i32.const 4))
      (local.get $ret))
    ;; error with no payload, for `result<u32>`
    (func (export "fail-none") (result i32)
      (local $ret i32)
      (local.set $ret (call $alloc (i32.const 8)))
      (i32.store8 (local.get $ret) (i32.const 1))
      (local.get $ret))
    ;; ok with no payload, for `result<_, string>`
    (func (export "succeed-none") (result i32)
      (local $ret i32)
      (local.set $ret (call $alloc (i32.const 12)))
      (i32.store8 (local.get $ret) (i32.const 0))
      (local.get $ret))
    ;; returns the discriminant of a `result<u32, string>` parameter
    (func (export "result-param") (param $disc i32) (param $a i32) (param $b i32) (result i32)
      (local.get $disc)))
  (core instance $m (instantiate $M (with "" (instance
    (export "mem" (memory $memory "mem"))
    (export "realloc" (func $memory "realloc"))
    (export "fallible" (func $fallible'))
    (export "fallible-u32" (func $fallible-u32'))
    (export "fallible-none" (func $fallible-none'))
    (export "fallible-no-ok" (func $fallible-no-ok'))
    (export "nested" (func $nested'))
    (export "plain" (func $plain'))))))

  (func $call-fallible (param "x" u32) (result (result u32 (error string)))
    (canon lift (core func $m "call-fallible") (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (func $call-fallible-u32 (result (result u32 (error u32)))
    (canon lift (core func $m "call-fallible-u32") (memory (core memory $memory "mem"))))
  (func $call-fallible-none (result (result))
    (canon lift (core func $m "call-fallible-none")))
  (func $call-fallible-no-ok (result (result (error string)))
    (canon lift (core func $m "call-fallible-no-ok") (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (func $call-nested (result (result (result u32 (error string)) (error string)))
    (canon lift (core func $m "call-nested") (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (func $call-plain (result u32)
    (canon lift (core func $m "call-plain")))
  (func $succeed (result (result u32 (error string)))
    (canon lift (core func $m "succeed") (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (func $fail (result (result u32 (error string)))
    (canon lift (core func $m "fail") (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (func $fail-none (result (result u32))
    (canon lift (core func $m "fail-none") (memory (core memory $memory "mem"))))
  (func $succeed-none (result (result (error string)))
    (canon lift (core func $m "succeed-none") (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))
  (func $result-param (param "x" (result u32 (error string))) (result u32)
    (canon lift (core func $m "result-param") (memory (core memory $memory "mem")) (realloc (core func $memory "realloc"))))

  (export "call-fallible" (func $call-fallible))
  (export "call-fallible-u32" (func $call-fallible-u32))
  (export "call-fallible-none" (func $call-fallible-none))
  (export "call-fallible-no-ok" (func $call-fallible-no-ok))
  (export "call-nested" (func $call-nested))
  (export "call-plain" (func $call-plain))
  (export "succeed" (func $succeed))
  (export "fail" (func $fail))
  (export "fail-none" (func $fail-none))
  (export "succeed-none" (func $succeed-none))
  (export "result-param" (func $result-param))
)
