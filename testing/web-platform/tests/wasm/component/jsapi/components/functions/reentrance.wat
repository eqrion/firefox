;; `outer` calls the import `cb`, which JS may use to re-enter the instance
;; through `inner` or `outer` itself while `outer` is still on the stack.
(component
  (import "cb" (func $cb (param "n" u32) (result u32)))
  (core func $cb' (canon lower (func $cb)))
  (core module $M
    (import "" "cb" (func $cb (param i32) (result i32)))
    (global $depth (mut i32) (i32.const 0))
    (global $max-depth (mut i32) (i32.const 0))
    (global $inner-calls (mut i32) (i32.const 0))
    (func (export "outer") (param $n i32) (result i32)
      (local $r i32)
      (global.set $depth (i32.add (global.get $depth) (i32.const 1)))
      (if (i32.gt_u (global.get $depth) (global.get $max-depth))
        (then (global.set $max-depth (global.get $depth))))
      (local.set $r (call $cb (local.get $n)))
      (global.set $depth (i32.sub (global.get $depth) (i32.const 1)))
      (i32.add (local.get $r) (i32.const 1)))
    (func (export "inner") (result i32)
      (global.set $inner-calls (i32.add (global.get $inner-calls) (i32.const 1)))
      (global.get $inner-calls))
    (func (export "max-depth") (result i32) (global.get $max-depth)))
  (core instance $m (instantiate $M (with "" (instance (export "cb" (func $cb'))))))
  (func $outer (param "n" u32) (result u32) (canon lift (core func $m "outer")))
  (func $inner (result u32) (canon lift (core func $m "inner")))
  (func $max-depth (result u32) (canon lift (core func $m "max-depth")))
  (export "outer" (func $outer))
  (export "inner" (func $inner))
  (export "max-depth" (func $max-depth))
)
